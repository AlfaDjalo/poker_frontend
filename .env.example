# Backend base URL. No trailing slash.
# Local dev: leave unset (falls back to http://localhost:8000)
# Production (Render Static Site env var):
# VITE_API_URL=https://poker-backend-zvsr.onrender.com
#
# NOTE: Vite inlines this at BUILD time. Changing it on Render requires a redeploy.
VITE_API_URL=http://localhost:8000